#!/bin/sh
# Codex hook entry (macOS/Linux). Usage: codex-peek-hook start|stop  (hook JSON on stdin)
# Finds or downloads the codex-peek binary, then forwards the hook to it.
# Never fails the hook: any problem exits 0 so Codex is not disturbed.
VERSION=0.1.1
REPO=hucheng91/codex-peek
ACTION=${1:-start}
DATA=${PLUGIN_DATA:-${TMPDIR:-/tmp}/codex-peek-plugin}

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) ASSET=codex-peek-macos-arm64 ;;
  Darwin-x86_64) ASSET=codex-peek-macos-x64 ;;
  Linux-x86_64) ASSET=codex-peek-linux-x64 ;;
  *) ASSET= ;;
esac

BIN=${CODEX_PEEK_BIN:-}
[ -z "$BIN" ] && command -v codex-peek-bin >/dev/null 2>&1 && BIN=$(command -v codex-peek-bin)
if [ -z "$BIN" ] && [ -n "$ASSET" ]; then
  BIN="$DATA/$VERSION/$ASSET"
  if [ ! -x "$BIN" ] && [ "$ACTION" = start ]; then
    mkdir -p "$DATA/$VERSION" &&
      curl -fsSL "https://github.com/$REPO/releases/download/v$VERSION/$ASSET" -o "$BIN.part" &&
      chmod +x "$BIN.part" && mv "$BIN.part" "$BIN"
  fi
fi
[ -n "$BIN" ] && [ -x "$BIN" ] || exit 0

if [ "$ACTION" = stop ]; then "$BIN" --hook-stop; else "$BIN" --hook-start $CODEX_PEEK_ARGS; fi
exit 0
